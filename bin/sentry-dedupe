#!/usr/bin/env php
<?php
declare(strict_types=1);

$autoloaders = [__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'];
foreach ($autoloaders as $autoload) { if (is_file($autoload)) { require $autoload; break; } }
exit((new \Kgkg\SentryDedupe\Cli\Application())->run(array_slice($argv, 1)));
